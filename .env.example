# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Server-only comma-separated Supabase Auth user UUIDs (no emails/passwords).
# Empty or malformed configuration denies all administrator access.
# Set actual approved UUIDs only in .env.local or the deployment environment.
MMAC_ADMIN_USER_IDS=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Portfolio demo mode: shows the demo banner and the demo contact note, and
# asks search engines not to index the site. ON unless set to exactly "false"
# (leave unset or "true" for the demo; "false" only for MMAC production).
# Build-time setting: redeploy after changing it.
NEXT_PUBLIC_DEMO_MODE=
